# Go Bjoun does not require API keys for the current public discovery beta.
# Add only the services you choose for the transactional launch.

# Customer accounts (recommended when cloud-synced saves and trip plans are added)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Direct marketplace payments and host payouts (only if Go Bjoun is merchant of record)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional third-party bookable inventory
VIATOR_API_KEY=
VIATOR_PARTNER_ID=

# Optional product monitoring
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
